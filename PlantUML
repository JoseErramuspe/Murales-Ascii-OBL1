@startuml
class Sistema {
   + Sistema()
   - listaAnimales : ArrayList<Animal>
   - listaFamilias : ArrayList<Familia>
   - listaEmpresas : ArrayList<Empresa>
   - listaAdopciones : ArrayList<Adopcion>
   - listaDonaciones : ArrayList<Donacion>
   + registrarAnimal(String, String, String, int) : void
   + registrarFamilia(String, String, String) : void
   + registrarEmpresa(String, int, String) : void
   + registrarAdopcion(Animal,Familia, String) : void
   + registrarDonacion(Empresa, int, int) : void
   + anularAdopcion(Adopcion) : void
   + importarDonaciones() : void
}

class Animal {
   + Animal(String, String, String, int, String)
   - nombre : String
   - codigo : String
   - temperamento : String
   - peso : int
   - estado : String
   + cambiarEstado() : void
}

class Familia {
   + Familia(String, String, int)
   - cedulaTitular : String
   - apellido : String
   - celular : int
}

class Empresa {
   + Empresa(String, int, String)
   - nombre : String
   - rut : int
   - direccion : String
}

class Adopcion {
   + Adopcion(Animal, Familia, String)
   - animal : Animal
   - familia : Familia
   - comentarios : String
}

class Donacion {
   + Donacion(Empresa, int, int, int)
   - empresaDonante : Empresa
   - tipoAlimento : int
   - kilos : int
   - codigo : int
}

Animal --o Sistema
Familia --o Sistema
Empresa --o Sistema
Adopcion --o Sistema
Donacion --o Sistema
Adopcion --> Animal
Adopcion --> Familia
Donacion --> Empresa
@enduml
