@startuml

class Sistema {
   + Sistema()
   - listaFichas : ArrayList<Ficha>
   - listaMurales : ArrayList<Mural>
   - listaDiseñadores : ArrayList<Diseñador>
   + Sistema()
   + agregarFicha(String, String, String, String): void
   + agregarMural(Diseñador, Ficha, Ficha, String): void
   + cambiarMural(int, Mural): void
   + agregarDiseñador(String, String, String): void
   + existeNombreDiseñador(String): boolean
   + existeNombreFicha(String): boolean
   + existeNombreMural(String): boolean
}

class Ficha {
   + Ficha(nombre: String, diseñoChico: String, diseñoGrande: String, color: String)
   - nombre : String
   - diseñoChico : String
   - diseñoGrande : String
   - color : String
}

class Mural {
   + Mural(ficha1 : Ficha, ficha2: Ficha, patron : String)
   - diseñoOriginal : Ficha[12][10]
   - diseñoActual : Ficha[12][10]
   + cantidadColores() : int
}

class Diseñador {
   + Diseñador(String, String, String)
   - nombre : String
   - direccion : String
   - mail : String
   - listaMurales : ArrayList<Mural>
   + cantidadMuralesCreados(): int
   + cantidadFichasUsadas() : int
   + cantidadColoresUsados() : int
   + toString(): String
   + compareTo(Diseñador): int
}

Ficha o-- Sistema
Mural o-- Sistema
Diseñador o-- Sistema
Mural o-- Ficha
Diseñador o-- Mural
@enduml
