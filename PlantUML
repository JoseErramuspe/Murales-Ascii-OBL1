@startuml

class Sistema {
   + Sistema()
   - listaFichas : ArrayList<Ficha>
   - listaMurales : ArrayList<Mural>
   - listaDiseñadores : ArrayList<Diseñador>
   + Sistema()
   + agregarFicha(String, String, String, String): void
   + agregarMural(Diseñador, Ficha, Ficha, String): void
   + cambiarMural(int, Mural): void
   + agregarDiseñador(String, String, String): void
   + existeNombreDiseñador(String): boolean
   + existeNombreFicha(String): boolean
   + existeNombreMural(String): boolean
}

class Ficha {
   + Ficha(String, String, String, String)
   - nombre : String
   - diseñoChico : String
   - diseñoGrande : String
   - color : String
   + puntosAEspacios(String) : String
}

class Mural {
   + Mural(String, Diseñador, Ficha[][], Ficha, Ficha, String, ArrayList<Ficha>)
   - nombre : String
   - diseñador : Diseñador
   - diseñoOriginal : Ficha[][]
   - diseñoActual : Ficha[][]
   - listaFichas : ArrayList<Ficha>
   + agregarFicha(Ficha) : void
   + modificarListaFichas(Ficha, Ficha) : void
   + cambiarPosicionFicha(Ficha, Ficha) : void
   + compararSimilitud(Sistema, int, int, int, int) : HashMap<Mural, int[]>
   + clonar(Ficha[][]) : Ficha[][]
   + restaurarListaFichas() : void
}

class Diseñador {
   + Diseñador(String, String, String)
   - nombre : String
   - direccion : String
   - mail : String
   - listaMurales : ArrayList<Mural>
   + cantidadMuralesCreados(): int
   + cantidadFichasUsadas() : int
   + cantidadColoresUsados() : int
   + toString(): String
   + compareTo(Diseñador): int
}

Ficha o-- Sistema
Mural o-- Sistema
Diseñador o-- Sistema
Mural o-- Ficha
Diseñador o-- Mural
@enduml
